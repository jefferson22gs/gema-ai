# GEMA AI — variáveis de ambiente (NUNCA commitar valores reais).
# Nenhuma é obrigatória para o build: integração sem chave aparece como "Não configurado".
# Somente variáveis NEXT_PUBLIC_* chegam ao navegador — nunca coloque segredos nelas.

# --- App / domínio ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_DOMAIN=
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_DPO_EMAIL=

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Conexão Postgres do servidor (Supavisor, modo transaction, porta 6543). Usada com RLS via role "authenticated".
DATABASE_URL=
DATABASE_POOL_MAX=5
# "true" somente após configurar o provedor Google no Supabase Auth.
NEXT_PUBLIC_GOOGLE_LOGIN_ENABLED=false

# --- Gemini (provedor primário de IA) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
GEMINI_EXTRACTION_MODEL=
# Teto mensal global de custo estimado (circuit breaker) e preços por milhão de tokens (USD) para estimativa.
GEMINI_MAX_MONTHLY_USD=50
GEMINI_PRICE_INPUT_PER_MTOK=0.30
GEMINI_PRICE_OUTPUT_PER_MTOK=2.50

# --- E-mail (Resend padrão, Brevo secundário/fallback) ---
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
BREVO_API_KEY=
BREVO_WEBHOOK_SECRET=
EMAIL_FROM="GEMA AI <no-reply@seu-dominio.com.br>"
EMAIL_PRIMARY_PROVIDER=resend

# --- WhatsApp: Evolution API (host persistente externo, NUNCA na Vercel) ---
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=
EVOLUTION_WEBHOOK_SECRET=
EVOLUTION_INTERACTIVE=false

# --- WhatsApp: Cloud API oficial (Meta) ---
META_WABA_PHONE_NUMBER_ID=
META_WHATSAPP_ACCESS_TOKEN=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=

# --- Google OAuth (Calendar + People) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/oauth/google/callback
# 32 bytes em base64: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
OAUTH_ENCRYPTION_KEY=

# --- Jobs agendados ---
CRON_SECRET=

# --- Cobrança (BillingProvider) ---
BILLING_PROVIDER=
BILLING_WEBHOOK_SECRET=

# --- Push PWA (VAPID): npx web-push generate-vapid-keys ---
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# --- Observabilidade ---
SENTRY_DSN=

# --- Seed de demonstração (nunca em produção) ---
ALLOW_DEMO_SEED=false
